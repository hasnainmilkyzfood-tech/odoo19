<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_department_cost_report_wizard_form" model="ir.ui.view">
        <field name="name">department.cost.report.wizard.form</field>
        <field name="model">department.cost.report.wizard</field>
        <field name="arch" type="xml">
            <form string="IT Department Cost Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="charge_state"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view_report" type="object"
                            string="View Report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_department_cost_report_wizard" model="ir.actions.act_window">
        <field name="name">IT Department Cost Report</field>
        <field name="res_model">department.cost.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
