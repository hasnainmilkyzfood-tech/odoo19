<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_it_notification_list" model="ir.ui.view">
        <field name="name">it.notification.list</field><field name="model">it.notification</field>
        <field name="arch" type="xml">
            <list string="Notifications" decoration-muted="is_read">
                <field name="create_date"/><field name="title"/><field name="message"/><field name="ticket_id"/><field name="is_read"/>
            </list>
        </field>
    </record>
    <record id="view_it_notification_form" model="ir.ui.view">
        <field name="name">it.notification.form</field><field name="model">it.notification</field>
        <field name="arch" type="xml">
            <form string="Notification">
                <header>
                    <button name="action_mark_read" type="object" string="Mark Read" invisible="is_read"/>
                    <button name="action_mark_unread" type="object" string="Mark Unread" invisible="not is_read"/>
                </header>
                <sheet><h2><field name="title"/></h2><group><field name="create_date"/><field name="ticket_id"/><field name="is_read"/></group><field name="message" nolabel="1"/></sheet>
            </form>
        </field>
    </record>
    <record id="action_it_notification" model="ir.actions.act_window">
        <field name="name">Notifications</field><field name="res_model">it.notification</field><field name="view_mode">list,form</field>
        <field name="domain">[('user_id','=',uid)]</field>
    </record>
</odoo>
