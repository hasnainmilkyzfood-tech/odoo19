<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_it_asset_list" model="ir.ui.view">
        <field name="name">it.asset.list</field>
        <field name="model">it.asset</field>
        <field name="arch" type="xml">
            <list string="IT Assets" decoration-danger="state == 'lost'" decoration-muted="state == 'retired'">
                <field name="asset_code"/>
                <field name="name"/>
                <field name="asset_type"/>
                <field name="brand"/>
                <field name="model_name"/>
                <field name="serial_number"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="state"/>
                <field name="warranty_expiry"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_it_asset_form" model="ir.ui.view">
        <field name="name">it.asset.form</field>
        <field name="model">it.asset</field>
        <field name="arch" type="xml">
            <form string="IT Asset">
                <header>
                    <button name="action_set_available" type="object" string="Set Available" invisible="state == 'available'"/>
                    <button name="action_set_assigned" type="object" string="Set Assigned" invisible="state == 'assigned'"/>
                    <button name="action_set_repair" type="object" string="Send to Repair" invisible="state == 'repair'"/>
                    <button name="action_set_retired" type="object" string="Retire" invisible="state == 'retired'"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,assigned,repair,retired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tickets" type="object" class="oe_stat_button" icon="fa-ticket">
                            <field name="ticket_count" widget="statinfo" string="Tickets"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Dell Latitude 5550"/></h1>
                        <div><field name="asset_code" readonly="1"/></div>
                    </div>
                    <group>
                        <group string="Asset">
                            <field name="asset_type"/>
                            <field name="brand"/>
                            <field name="model_name"/>
                            <field name="serial_number"/>
                            <field name="location"/>
                        </group>
                        <group string="Assignment">
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Purchase &amp; Warranty">
                            <group>
                                <group>
                                    <field name="purchase_date"/>
                                    <field name="purchase_cost"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                                <group>
                                    <field name="vendor_id"/>
                                    <field name="warranty_expiry"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="note" placeholder="Configuration, accessories, remarks..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_it_asset_search" model="ir.ui.view">
        <field name="name">it.asset.search</field>
        <field name="model">it.asset</field>
        <field name="arch" type="xml">
            <search string="Search IT Assets">
                <field name="name"/>
                <field name="asset_code"/>
                <field name="serial_number"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter string="Available" name="available" domain="[('state','=','available')]"/>
                <filter string="Assigned" name="assigned" domain="[('state','=','assigned')]"/>
                <filter string="Repair" name="repair" domain="[('state','=','repair')]"/>
                <separator/>
                <filter string="Group by Type" name="group_type" context="{'group_by':'asset_type'}"/>
                <filter string="Group by Status" name="group_state" context="{'group_by':'state'}"/>
                <filter string="Group by Department" name="group_department" context="{'group_by':'department_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_it_asset" model="ir.actions.act_window">
        <field name="name">IT Assets</field>
        <field name="res_model">it.asset</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_it_asset_search"/>
    </record>
</odoo>
