<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_it_maintenance_list" model="ir.ui.view">
        <field name="name">it.maintenance.list</field>
        <field name="model">it.maintenance</field>
        <field name="arch" type="xml">
            <list string="IT Maintenance" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="maintenance_date"/>
                <field name="maintenance_type"/>
                <field name="technician_id"/>
                <field name="vendor_id"/>
                <field name="cost"/>
                <field name="next_maintenance_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_it_maintenance_form" model="ir.ui.view">
        <field name="name">it.maintenance.form</field>
        <field name="model">it.maintenance</field>
        <field name="arch" type="xml">
            <form string="IT Maintenance">
                <header>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'planned'"/>
                    <button name="action_reset" type="object" string="Reset to Planned" invisible="state == 'planned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="maintenance_date"/>
                            <field name="maintenance_type"/>
                            <field name="next_maintenance_date"/>
                        </group>
                        <group>
                            <field name="technician_id"/>
                            <field name="vendor_id"/>
                            <field name="cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Work Details">
                        <field name="description" nolabel="1" placeholder="Work performed, parts changed, observations..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_it_maintenance_search" model="ir.ui.view">
        <field name="name">it.maintenance.search</field>
        <field name="model">it.maintenance</field>
        <field name="arch" type="xml">
            <search string="Search Maintenance">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="technician_id"/>
                <filter string="Planned" name="planned" domain="[('state','=','planned')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <separator/>
                <filter string="Group by Asset" name="group_asset" context="{'group_by':'asset_id'}"/>
                <filter string="Group by Type" name="group_type" context="{'group_by':'maintenance_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_it_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">it.maintenance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_it_maintenance_search"/>
    </record>
</odoo>
