<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_it_support_chat_list" model="ir.ui.view">
        <field name="name">it.support.chat.list</field><field name="model">it.support.chat</field>
        <field name="arch" type="xml">
            <list string="Support Chat" decoration-success="state == 'open'">
                <field name="name"/><field name="subject"/><field name="employee_id"/><field name="source_ip"/><field name="anydesk_id"/><field name="assigned_to_id"/><field name="state"/><field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="view_it_support_chat_form" model="ir.ui.view">
        <field name="name">it.support.chat.form</field><field name="model">it.support.chat</field>
        <field name="arch" type="xml">
            <form string="Support Conversation">
                <header>
                    <button name="action_close" type="object" string="Close Conversation" invisible="state == 'closed'"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="state == 'open'"/>
                    <button name="action_open_anydesk" type="object" string="Connect AnyDesk" class="btn-primary" invisible="not anydesk_id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="subject" placeholder="Conversation subject"/></h1></div>
                    <group>
                        <group><field name="name" readonly="1"/><field name="employee_id"/><field name="assigned_to_id"/></group>
                        <group string="Remote Support"><field name="source_ip" readonly="1"/><field name="anydesk_id" placeholder="AnyDesk ID"/></group>
                    </group>
                    <group string="Initial Message"><field name="message_body" nolabel="1"/></group>
                    <group string="Attachments"><field name="attachment_ids" widget="many2many_binary" nolabel="1"/></group>
                    <div class="alert alert-info" role="alert">Continue the conversation in the chatter below. This uses Odoo's native messaging instead of a custom JSON endpoint.</div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_it_support_chat" model="ir.actions.act_window">
        <field name="name">Support Chat</field><field name="res_model">it.support.chat</field><field name="view_mode">list,form</field>
    </record>
    <record id="action_it_support_chat_create" model="ir.actions.act_window">
        <field name="name">New Conversation</field><field name="res_model">it.support.chat</field><field name="view_mode">form</field><field name="target">current</field>
    </record>
</odoo>
