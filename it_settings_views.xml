<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_it_management" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.it.management</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="IT Management" name="it_management">
                    <block title="IT Inventory" name="it_inventory_settings">
                        <setting string="IT Stock Location" help="Default internal location holding IT spares and consumables.">
                            <field name="it_stock_location_id"/>
                        </setting>
                        <setting string="IT Consumption Location" help="Destination used for draft IT parts consumption transfers.">
                            <field name="it_consumption_location_id"/>
                        </setting>
                        <setting string="Internal Transfer Operation Type">
                            <field name="it_internal_picking_type_id"/>
                        </setting>
                        <setting string="Purchase Deliver-To Operation Type">
                            <field name="it_purchase_picking_type_id"/>
                        </setting>
                        <setting string="Default Low Stock Threshold">
                            <field name="it_low_stock_threshold"/>
                        </setting>
                    </block>
                    <block title="IT Accounting" name="it_accounting_settings">
                        <setting string="Default IT Expense Account">
                            <field name="it_default_expense_account_id"/>
                        </setting>
                        <setting string="Default IT Journal">
                            <field name="it_default_journal_id"/>
                        </setting>
                        <setting string="IT Recovery / Shared Services Analytic Account"
                                 help="Optional. Credited on department charge-back entries so IT's own analytic reporting reflects recovered cost.">
                            <field name="it_recovery_analytic_account_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_it_settings" model="ir.actions.act_window">
        <field name="name">IT Management Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'it_management'}</field>
    </record>
</odoo>
